# === Vercel Frontend Environment Variables ===
# Copy this file to .env and fill in your values
# All variables MUST start with VITE_ to be accessible in the browser

# Firebase Configuration (from Firebase Console → Project Settings → Your Apps → Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Backend API URL (your Render deployment URL)
VITE_API_URL=https://your-backend-name.onrender.com

# Cloudinary (for profile picture uploads — same cloud name as backend)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
